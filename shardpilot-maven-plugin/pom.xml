<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.sjacek</groupId><artifactId>shardpilot-parent</artifactId><version>0.3.0</version></parent>
  <artifactId>shardpilot-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>ShardPilot Maven plugin</name>
  <description>ShardPilot helps shorten CI feedback for large JVM unit and integration test suites by
    splitting Maven Surefire and Failsafe test classes into deterministic, non-overlapping shards for
    parallel CI jobs. It balances class families using historical test durations and uses stable
    hashing when timing data is unavailable. The plugin preserves native test execution and configured
    class include/exclude patterns, with independent suites for unit and integration tests. The prepare,
    select and verify goals produce readable YAML manifests and standalone JSON and HTML reports to
    compare planned class assignments with selections collected from every CI job. Supports single-module
    projects and parallel Maven reactor builds without a coordinator, replacement test runner or
    telemetry. Your build controls test JVMs and normal test outcomes; your CI launches every shard
    and collects the results. Class-selection verification complements the native test result checks.</description>
  <prerequisites><maven>3.9.0</maven></prerequisites>
  <dependencies>
    <dependency><groupId>io.github.sjacek</groupId><artifactId>shardpilot-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-plugin-api</artifactId><version>3.9.16</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-core</artifactId><version>3.9.16</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.plugin-tools</groupId><artifactId>maven-plugin-annotations</artifactId><version>3.15.1</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.surefire</groupId><artifactId>surefire-api</artifactId><version>${surefire.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources><resource><directory>..</directory><includes><include>LICENSE</include></includes><targetPath>META-INF</targetPath></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-plugin-plugin</artifactId><version>3.15.1</version>
        <configuration><goalPrefix>shardpilot</goalPrefix></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-invoker-plugin</artifactId><version>3.9.1</version>
        <configuration>
          <skipInvocation>${skipITs}</skipInvocation>
          <skipInstallation>${skipITs}</skipInstallation>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/it-repository</localRepositoryPath>
          <showErrors>true</showErrors>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <postBuildHookScript>verify</postBuildHookScript>
          <goals><goal>verify</goal></goals>
        </configuration>
        <dependencies>
          <dependency><groupId>org.apache.groovy</groupId><artifactId>groovy</artifactId><version>4.0.29</version></dependency>
          <dependency><groupId>org.snakeyaml</groupId><artifactId>snakeyaml-engine</artifactId><version>3.2</version></dependency>
        </dependencies>
        <executions>
          <execution><id>real-maven-builds</id><goals><goal>install</goal><goal>run</goal></goals>
            <configuration><pomIncludes><pomInclude>*/pom.xml</pomInclude></pomIncludes></configuration>
          </execution>
          <execution><id>runnable-examples</id><goals><goal>run</goal></goals>
            <configuration>
              <projectsDirectory>${project.basedir}/../examples/maven</projectsDirectory>
              <cloneProjectsTo>${project.build.directory}/examples</cloneProjectsTo>
              <pomIncludes><pomInclude>*/pom.xml</pomInclude></pomIncludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
