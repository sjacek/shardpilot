<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example.shardpilot</groupId><artifactId>compiled-artifacts</artifactId><version>1</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <shardpilot.compiledRevision>aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</shardpilot.compiledRevision>
    <shardpilot.compiledSuite>native</shardpilot.compiledSuite>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
    <!-- The explicit offline provider must launch the same Platform version as the test engine. -->
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><version>6.1.3</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
    <plugin><groupId>io.github.sjacek</groupId><artifactId>shardpilot-maven-plugin</artifactId><version>@project.version@</version>
      <configuration>
        <compiledRoots><compiledRoot>target/test-classes</compiledRoot></compiledRoots>
        <compiledRequiredDirectories><compiledRequiredDirectory>target/test-classes/example</compiledRequiredDirectory></compiledRequiredDirectories>
        <compiledRequiredFiles><compiledRequiredFile>target/test-classes/config.txt</compiledRequiredFile></compiledRequiredFiles>
      </configuration>
    </plugin>
    <!-- Make the normally dynamic provider part of help's resolution graph: worker invocations
         deliberately run offline and must not depend on a previously warmed Invoker repository. -->
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
      <dependencies><dependency><groupId>org.apache.maven.surefire</groupId><artifactId>surefire-junit-platform</artifactId><version>3.5.4</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version>
      <dependencies><dependency><groupId>org.apache.maven.surefire</groupId><artifactId>surefire-junit-platform</artifactId><version>3.5.4</version></dependency></dependencies>
    </plugin>
  </plugins></build>
</project>
