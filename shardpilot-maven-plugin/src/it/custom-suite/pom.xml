<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>example.shardpilot</groupId><artifactId>custom-suite</artifactId><version>1</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <shardpilot.index>1</shardpilot.index>
    <native.includes>config/includes.txt</native.includes>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
    <plugin>
      <groupId>io.github.sjacek</groupId><artifactId>shardpilot-maven-plugin</artifactId><version>@project.version@</version>
      <configuration>
        <suite>privacy-catalog</suite>
        <directory>${project.build.directory}/custom evidence</directory>
        <durationsFile>${project.basedir}/config/durations.tsv</durationsFile>
        <additionalExcludesFile>${project.basedir}/config/excludes.txt</additionalExcludesFile>
        <reportFile>${project.build.directory}/custom reports/selection.json</reportFile>
        <htmlReportFile>${project.build.directory}/custom reports/selection.html</htmlReportFile>
      </configuration>
      <executions><execution><id>select-custom-suite</id><goals><goal>select</goal></goals></execution></executions>
    </plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
      <configuration>
        <!-- The adapter must evaluate the same relative pattern-file path as the native runner. -->
        <includesFile>${native.includes}</includesFile>
        <excludesFile>${project.build.directory}/custom evidence/excludes.txt</excludesFile>
        <reportsDirectory>${project.build.directory}/surefire-reports/shard-${shardpilot.index}</reportsDirectory>
        <argLine>-Xmx256m</argLine>
      </configuration>
    </plugin>
  </plugins></build>
</project>
