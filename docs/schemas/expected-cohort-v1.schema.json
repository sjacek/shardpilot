{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjacek.github.io/shardpilot/schemas/expected-cohort-v1.schema.json",
  "title": "ShardPilot C2 trusted aggregation request v1 (development API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cohort",
    "selection",
    "shardCount",
    "expectedNodes",
    "skipPolicy",
    "allowEmptyShards",
    "minimumExecutedTests",
    "maximumSkippedTests"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cohort": {
      "$ref": "execution-evidence-v1.schema.json#/$defs/cohort"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "sha256",
        "eligibilitySha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "explicit"
          ]
        },
        "sha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "eligibilitySha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "shardCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "expectedNodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "jobId",
          "planSha256",
          "jobStartedAt",
          "jobFinishedAt"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "jobId": {
            "$ref": "execution-evidence-v1.schema.json#/$defs/identifier"
          },
          "planSha256": {
            "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
          },
          "jobStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "jobFinishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "skipPolicy": {
      "enum": [
        "allow",
        "reject"
      ]
    },
    "allowEmptyShards": {
      "type": "boolean"
    },
    "minimumExecutedTests": {
      "type": "integer",
      "minimum": 0
    },
    "maximumSkippedTests": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
