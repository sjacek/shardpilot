{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjacek.github.io/shardpilot/schemas/execution-selection-v2.schema.json",
  "title": "ShardPilot replayed selection v2 (development API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "mode": {
      "enum": [
        "full",
        "explicit"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^$]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "full"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "families"
          ],
          "properties": {
            "families": {}
          }
        }
      },
      "else": {
        "required": [
          "families"
        ],
        "properties": {
          "families": {}
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "suite",
        "shardCount",
        "profile",
        "profileMode",
        "engineVersion",
        "decisionIdentity",
        "policySha256",
        "gitSha256",
        "historySha256",
        "eligibilitySha256",
        "sourceManifestSha256",
        "cohortSha256",
        "compiledArtifactsSha256",
        "planSha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "suite": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![Ff][Uu][Ll][Ll]$)[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "shardCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "profileMode": {
          "enum": [
            "FULL",
            "SMOKE",
            "AFFECTED",
            "EXPLICIT"
          ]
        },
        "engineVersion": {
          "const": 1
        },
        "decisionIdentity": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "policySha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "gitSha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "historySha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "eligibilitySha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "sourceManifestSha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "cohortSha256": {
          "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
        },
        "compiledArtifactsSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
            }
          ]
        },
        "planSha256": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1024,
          "additionalProperties": false,
          "patternProperties": {
            "^[1-9][0-9]{0,3}$": {
              "$ref": "execution-evidence-v1.schema.json#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
