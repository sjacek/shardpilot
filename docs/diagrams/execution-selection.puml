@startuml
title Frozen selection bound to native execution
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
rectangle "Trusted planning inputs\npolicy + Git + E + history + revision" as inputs
rectangle "Frozen C5 decision\nselected families + per-node plans" as decision
rectangle "Optional C3 v1 manifest\nverified actual compilation trees" as compiled
rectangle "Canonical selection v2\ndecision + input + plan + C3 hashes" as selection
rectangle "Native workers\nrestore C5 / guard C3 / run tests" as workers
rectangle "C2 v1 node evidence\nselection hash + exit + XML / ledger" as nodes
rectangle "Independent expected cohort\nCI jobs + selection / plan hashes" as expected
rectangle "C2 aggregate gate\nrecheck bindings + native outcomes" as gate
rectangle "JSON / HTML report v2" as report
inputs --> decision
decision --> selection : replay
compiled --> selection : optional
decision --> workers
compiled --> workers : optional pre-test guard
selection --> nodes : exact digest
workers --> nodes
selection --> expected : authenticated planning channel
expected --> gate
nodes --> gate
compiled --> gate : optional byte recheck
gate --> report
@enduml
