@startuml
title ShardPilot: shared core and sibling adapters
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #2563EB
skinparam ArrowColor #475569
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #D97706

component "shardpilot-core\nHistory + assignment + XML refresh\nYAML + coverage + HTML\nNo build-tool APIs" as core
component "shardpilot-gradle-plugin\nTest filters / process options\nManaged artifact tasks" as gradle
component "shardpilot-maven-plugin\nNative runner filter adapter\nprepare / select / verify\nStandalone refresh-durations" as maven
artifact "Gradle distribution\nio.github.sjacek:shardpilot\nUnchanged plugin ID and DSL" as gradleJar #F1F5F9
artifact "Maven distribution\nio.github.sjacek:shardpilot-maven-plugin\nNormal dependency on shardpilot-core" as mavenJar #F1F5F9

gradle --> core : uses shared sources
maven --> core : dependency
gradle --> gradleJar : bundles core classes
maven --> mavenJar : native plugin descriptor

note bottom of core
  Java 17; original public Java package retained.
  One planner and one manifest/report contract.
end note
note bottom of gradleJar
  Repository-root includeBuild still works.
  No separate core publication needed for Gradle.
end note
@enduml
