@startuml
title ShardPilot: component responsibilities
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #2563EB
skinparam packageBorderColor #94A3B8
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #D97706

package "Consumer task configuration" {
  component "ShardPilotPlugin\nconfigureEach(Test)" as plugin
  component "ShardPilotExtension\nsettings owned by one Test task" as settings
}

package "Core task behavior" {
  component "TestProcessOptions\noptional heap / forks / recycling" as processes
  component "PrepareShardAction\nvalidate + log metadata" as prepare
  component "ShardClassFilter\nexclude non-owned candidates" as filter
}

package "Opt-in class manifests" {
  component "ShardVerification\nregister typed sibling tasks" as verification
  component "Prepare / Write / Verify\nYAML + JSON / HTML coverage" as manifests
}

package "Shared assignment" {
  component "DurationHistory\nparse and validate TSV" as history
  component "ShardPlan\nmeasured packing + hash fallback" as plan
}

plugin --> settings : attach extension to Test
settings --> processes : testProcesses(action)
settings --> prepare : doFirst hook
settings --> filter : exclusion hook
settings --> verification : verification(action)
verification --> manifests : explicit opt-in
prepare --> filter : obtain plan
filter --> history : parse contents
history --> plan : measured families
filter --> plan : query ownership
manifests --> plan : preparation reuses planner

note bottom of processes
  Uses public Gradle Test setters.
  Gradle owns worker processes.
end note
note bottom of plan
  Nested classes share a family owner.
  The consumer owns test frameworks,
  execution and normal failure policy.
end note
@enduml
