<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.sjacek</groupId>
  <artifactId>shardpilot-parent</artifactId>
  <version>0.5.0</version>
  <packaging>pom</packaging>
  <name>ShardPilot build parent</name>
  <description>ShardPilot helps shorten CI feedback by splitting JVM test classes into deterministic,
    non-overlapping shards for parallel CI jobs. Gradle and Maven adapters share balancing based on
    historical test durations, stable hashing when timings are unavailable, YAML class manifests and
    standalone JSON and HTML reports for verifying class selections. This parent POM supplies shared
    dependency and build configuration for shardpilot-core and shardpilot-maven-plugin. Consumers
    configure the appropriate build-tool adapter; class-selection verification complements normal
    test result checks. Opt-in history refresh creates candidate TSV and JSON from existing JUnit XML
    without rerunning tests or modifying maintained history. Optional YAML selection manifests choose a test
    subset before planning, with separate suite evidence for one or multiple shards.</description>
  <url>https://github.com/sjacek/shardpilot</url>
  <licenses><license><name>MIT License</name><url>https://opensource.org/license/mit</url></license></licenses>
  <developers>
    <developer><id>sjacek</id><name>sjacek</name><url>https://github.com/sjacek</url></developer>
  </developers>
  <!-- All modules share one repository. Maven must not append artifact names to these URLs. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/sjacek/shardpilot.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sjacek/shardpilot.git</developerConnection>
    <url>https://github.com/sjacek/shardpilot</url>
    <tag>v${project.version}</tag>
  </scm>
  <modules>
    <module>shardpilot-core</module>
    <module>shardpilot-maven-plugin</module>
  </modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>6.1.3</junit.version>
    <surefire.version>3.6.1</surefire.version>
    <skipITs>false</skipITs>
    <!-- Producer-plugin realms do not inherit project dependencyManagement. Keep their
         security updates explicit and scoped; these are not ShardPilot runtime libraries. -->
    <tooling.jackson.version>2.22.4</tooling.jackson.version>
    <tooling.guava.version>33.7.2-jre</tooling.guava.version>
    <tooling.plexus3.version>3.6.2</tooling.plexus3.version>
    <tooling.plexus4.version>4.0.3</tooling.plexus4.version>
    <tooling.archiver.version>4.15.0</tooling.archiver.version>
    <tooling.beanutils.version>1.11.0</tooling.beanutils.version>
    <tooling.jsoup.version>1.23.2</tooling.jsoup.version>
    <tooling.bouncycastle.version>1.87</tooling.bouncycastle.version>
  </properties>
  <dependencyManagement><dependencies>
    <dependency><groupId>org.junit</groupId><artifactId>junit-bom</artifactId><version>${junit.version}</version><type>pom</type><scope>import</scope></dependency>
    <!-- Maven's provided API graph includes Guava. Keep the API baseline while selecting
         patched transitive bytes for producer compilation/tests; no runtime dependency is added. -->
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>${tooling.guava.version}</version></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>${surefire.version}</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>${surefire.version}</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-help-plugin</artifactId><version>3.5.2</version>
      <dependencies><dependency><groupId>org.jsoup</groupId><artifactId>jsoup</artifactId><version>${tooling.jsoup.version}</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version>
      <dependencies><dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus4.version}</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version>
      <dependencies><dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus3.version}</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version>
      <dependencies>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus4.version}</version></dependency>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-archiver</artifactId><version>${tooling.archiver.version}</version></dependency>
      </dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.12.0</version>
      <dependencies>
        <dependency><groupId>commons-beanutils</groupId><artifactId>commons-beanutils</artifactId><version>${tooling.beanutils.version}</version></dependency>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus4.version}</version></dependency>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-archiver</artifactId><version>${tooling.archiver.version}</version></dependency>
      </dependencies>
    </plugin>
    <!-- Maven injects site lifecycle bindings even though CI does not invoke that lifecycle.
         Retain the current pin and full scan: deleting this entry restores an older default,
         rather than removing the Site/Jetty realm. The sanitized tooling model explains it. -->
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-site-plugin</artifactId><version>3.22.0</version>
      <dependencies>
        <dependency><groupId>commons-beanutils</groupId><artifactId>commons-beanutils</artifactId><version>${tooling.beanutils.version}</version></dependency>
        <dependency><groupId>org.jsoup</groupId><artifactId>jsoup</artifactId><version>${tooling.jsoup.version}</version></dependency>
      </dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.11.0</version>
      <dependencies><dependency><groupId>commons-beanutils</groupId><artifactId>commons-beanutils</artifactId><version>${tooling.beanutils.version}</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-invoker-plugin</artifactId><version>3.10.1</version>
      <dependencies>
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.18.0</version></dependency>
        <dependency><groupId>org.iq80.snappy</groupId><artifactId>snappy</artifactId><version>0.5</version></dependency>
      </dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
      <dependencies>
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>${tooling.bouncycastle.version}</version></dependency>
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcpg-jdk18on</artifactId><version>${tooling.bouncycastle.version}</version></dependency>
        <dependency><groupId>org.bouncycastle</groupId><artifactId>bcutil-jdk18on</artifactId><version>${tooling.bouncycastle.version}</version></dependency>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus3.version}</version></dependency>
      </dependencies>
    </plugin>
    <plugin><groupId>org.cyclonedx</groupId><artifactId>cyclonedx-maven-plugin</artifactId><version>2.9.3</version>
      <dependencies>
        <dependency><groupId>org.cyclonedx</groupId><artifactId>cyclonedx-core-java</artifactId><version>11.0.1</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>${tooling.jackson.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${tooling.jackson.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-xml</artifactId><version>${tooling.jackson.version}</version></dependency>
      </dependencies>
    </plugin>
    <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.12.0</version>
      <dependencies>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>${tooling.jackson.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${tooling.jackson.version}</version></dependency>
        <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>${tooling.guava.version}</version></dependency>
        <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><version>5.6.5</version></dependency>
        <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5</artifactId><version>5.4.4</version></dependency>
        <dependency><groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5-h2</artifactId><version>5.4.4</version></dependency>
        <dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>${tooling.plexus3.version}</version></dependency>
      </dependencies>
    </plugin>
  </plugins></pluginManagement></build>
  <profiles>
    <profile>
      <id>verified-maven-consumers</id>
      <activation><property><name>codes.rafael.mavenchecksumextension.mode</name></property></activation>
      <!-- Root invocations verify against committed sums. Invoker additionally installs this checkout's
           candidate artifacts and hashes those exact five files into a disposable consumer baseline. -->
      <build><pluginManagement><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-invoker-plugin</artifactId>
        <configuration>
          <preBuildHookScript>../../../../scripts/prepare-maven-consumer-checksums.groovy</preBuildHookScript>
          <scriptVariables>
            <verificationRoot>${maven.multiModuleProjectDirectory}</verificationRoot>
            <verificationRepository>${project.build.directory}/it-repository</verificationRepository>
            <verificationVersion>${project.version}</verificationVersion>
          </scriptVariables>
          <mavenOpts>${env.MAVEN_OPTS} ${env.SHARDPILOT_MAVEN_CONSUMER_OPTS}</mavenOpts>
        </configuration>
      </plugin></plugins></pluginManagement></build>
    </profile>
    <profile>
      <id>security-sbom</id>
      <!-- Separate inventories retain the consumer runtime boundary while also scanning producer
           tests and host-provided APIs. None of these reports becomes a publication attachment. -->
      <build><plugins><plugin>
        <groupId>org.cyclonedx</groupId><artifactId>cyclonedx-maven-plugin</artifactId><version>2.9.3</version>
        <configuration>
          <schemaVersion>1.6</schemaVersion><projectType>library</projectType>
          <includeCompileScope>true</includeCompileScope><includeRuntimeScope>true</includeRuntimeScope>
          <includeProvidedScope>false</includeProvidedScope><includeSystemScope>false</includeSystemScope>
          <includeTestScope>false</includeTestScope><outputFormat>json</outputFormat>
          <outputDirectory>${project.build.directory}/reports/security/maven</outputDirectory>
          <outputName>bom.raw</outputName><skipAttach>true</skipAttach>
        </configuration>
        <executions>
          <execution><id>runtime-sbom</id><phase>package</phase><goals><goal>makeBom</goal></goals></execution>
          <execution><id>test-sbom</id><phase>package</phase><goals><goal>makeBom</goal></goals>
            <configuration>
              <!-- Maven's effective test classpath includes compile/runtime/provided transitives. -->
              <includeCompileScope>true</includeCompileScope><includeRuntimeScope>true</includeRuntimeScope>
              <includeProvidedScope>true</includeProvidedScope><includeTestScope>true</includeTestScope>
              <outputDirectory>${project.build.directory}/reports/security/maven/test</outputDirectory>
            </configuration>
          </execution>
          <execution><id>provided-sbom</id><phase>package</phase><goals><goal>makeBom</goal></goals>
            <configuration>
              <!-- Keep transitive compile edges; finalization selects provided roots from dependency:tree. -->
              <includeCompileScope>true</includeCompileScope><includeRuntimeScope>true</includeRuntimeScope>
              <includeProvidedScope>true</includeProvidedScope>
              <outputDirectory>${project.build.directory}/reports/security/maven/provided</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- resolve-plugins inventories effective build/report plugin realms, including transitives.
           It is invoked directly: activating central-release for resolution runs no release goals. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.11.0</version>
        <configuration>
          <excludeReactor>false</excludeReactor><excludeTransitive>false</excludeTransitive>
          <outputAbsoluteArtifactFilename>true</outputAbsoluteArtifactFilename>
          <outputFile>${project.build.directory}/reports/security/maven/build/plugins.raw.txt</outputFile>
        </configuration>
        <executions><execution><id>security-scope-tree</id><phase>package</phase><goals><goal>tree</goal></goals>
          <configuration>
            <outputType>json</outputType>
            <outputFile>${project.build.directory}/reports/security/maven/project-dependencies.raw.json</outputFile>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>central-release</id>
      <properties>
        <!-- Local release checks produce the exact bundle but never upload by default. -->
        <central.skipUpload>true</central.skipUpload>
        <central.waitUntil>published</central.waitUntil>
      </properties>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version>
          <executions><execution><id>attach-sources</id><phase>package</phase><goals><goal>jar-no-fork</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.12.0</version>
          <configuration>
            <release>${maven.compiler.release}</release><encoding>UTF-8</encoding><docencoding>UTF-8</docencoding>
            <detectJavaApiLink>false</detectJavaApiLink><detectOfflineLinks>false</detectOfflineLinks>
            <notimestamp>true</notimestamp><failOnError>true</failOnError><failOnWarnings>true</failOnWarnings>
          </configuration>
          <executions><execution><id>attach-javadoc</id><phase>package</phase><goals><goal>jar</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
          <configuration>
            <!-- BC reads the key and passphrase from environment variables, not a shared keyring. -->
            <signer>bc</signer><bestPractices>true</bestPractices><useAgent>false</useAgent>
          </configuration>
          <executions><execution><id>sign-release-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.12.0</version>
          <extensions>true</extensions>
          <configuration>
            <publishingServerId>central</publishingServerId>
            <skipUpload>${central.skipUpload}</skipUpload>
            <deploymentName>ShardPilot ${project.version}</deploymentName>
            <autoPublish>true</autoPublish><waitUntil>${central.waitUntil}</waitUntil><waitMaxTime>1800</waitMaxTime>
          </configuration>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
